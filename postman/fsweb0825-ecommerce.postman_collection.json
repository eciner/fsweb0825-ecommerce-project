    {
      "name": "Roles",
      "item": [
        {
          "name": "GET /roles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"roles returns 200\", () => pm.response.to.have.status(200));",
                  "const roles = pm.response.json();",
                  "const customer = roles.find((role) => role.code === \"customer\");",
                  "const store = roles.find((role) => role.code === \"store\");",
                  "const admin = roles.find((role) => role.code === \"admin\");",
                  "pm.test(\"required roles are present\", () => { pm.expect(customer).to.exist; pm.expect(store).to.exist; pm.expect(admin).to.exist; });",
                  "pm.collectionVariables.set(\"customerRoleId\", String(customer.id));",
                  "pm.collectionVariables.set(\"storeRoleId\", String(store.id));",
                  "pm.collectionVariables.set(\"adminRoleId\", String(admin.id));"
                ]
              }
            }
          ]
        }
      ]
    },
