                  "pm.test(\"temporary card exists with update applied\", () => { pm.response.to.have.status(200); const cards = pm.response.json(); const item = cards.find((value) => String(value.id) === String(pm.environment.get(\"cardId\"))); pm.expect(item).to.exist; pm.expect(item.name_on_card).to.include(\"UPDATED\"); pm.expect(item).not.to.have.any.keys(\"ccv\", \"card_ccv\", \"cvv\", \"cvc\"); });"
                ]
              }
            }
