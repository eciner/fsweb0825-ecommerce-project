        },
        {
          "name": "POST /order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_id\": {{addressId}},\n  \"card_no\": \"{{cardNo}}\",\n  \"card_name\": \"{{cardName}}\",\n  \"card_expire_month\": {{expireMonth}},\n  \"card_expire_year\": {{expireYear}},\n  \"card_ccv\": \"{{cardCcv}}\",\n  \"price\": {{orderPrice}},\n  \"products\": [\n    {\n      \"product_id\": 1,\n      \"count\": 1,\n      \"detail\": \"Phase 10A local Newman order\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "order"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"local order created\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test(\"server price overrides client price\", () => pm.expect(Number(order.price)).to.eql(Number(pm.collectionVariables.get(\"canonicalProductPrice\"))));",
                  "pm.test(\"order contains product 1 quantity 1\", () => pm.expect(order.products.some((line) => Number(line.product_id) === 1 && Number(line.count) === 1)).to.be.true);",
                  "pm.test(\"order response contains no payment secrets\", () => { pm.expect(order).not.to.have.any.keys(\"card_no\", \"card_ccv\", \"ccv\", \"cvv\", \"cvc\"); });",
                  "pm.environment.set(\"orderId\", String(order.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /order",
          "request": {
            "method": "GET",
            "header": [
