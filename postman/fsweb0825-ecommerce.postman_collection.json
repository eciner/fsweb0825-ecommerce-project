                  "const order = orders.find((item) => String(item.id) === String(pm.environment.get(\"orderId\")));",
                  "pm.test(\"created order is in history\", () => pm.expect(order).to.exist);",
                  "pm.test(\"history contains one product 1 unit\", () => pm.expect(order.products.some((line) => Number(line.product_id) === 1 && Number(line.count) === 1)).to.be.true);",
                  "pm.test(\"history contains no payment secrets\", () => { pm.expect(order).not.to.have.any.keys(\"card_no\", \"card_ccv\", \"ccv\", \"cvv\", \"cvc\"); });"
                ]
