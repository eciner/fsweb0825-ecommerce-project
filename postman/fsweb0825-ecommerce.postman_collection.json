    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const rawBaseUrl = String(pm.variables.get(\"baseUrl\") || \"\");",
          "const isLocalBackend = /^http:\\/\\/(localhost|127\\.0\\.0\\.1):8080\\/?$/i.test(rawBaseUrl);",
          "if (!isLocalBackend) { pm.execution.skipRequest(); }",
          "if (!pm.collectionVariables.get(\"runId\")) pm.collectionVariables.set(\"runId\", Date.now().toString());"
        ]
      }
    }
